{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "paths": {
      "@auth/*": ["./src/auth/*"],
      "@categories/*": ["./src/categories/*"],
      "@transactions/*": ["./src/transactions/*"],
      "@prisma-module/*": ["./src/prisma/*"],
      "@common/*": ["./src/common/*"],
      "@config/*": ["./src/config/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
