{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./src",
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "paths": {
      "@auth/*": ["auth/*"],
      "@categories/*": ["categories/*"],
      "@transactions/*": ["transactions/*"],
      "@prisma-module/*": ["prisma/*"],
      "@common/*": ["common/*"],
      "@config/*": ["config/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
